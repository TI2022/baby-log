# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules
/backend/vendor/bundle
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/frontend/coverage

# next.js
/.next/
/frontend/.next/
/frontend/out/

# production
/build
/frontend/build
/backend/public/assets

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/frontend/.env*
/backend/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# API generated files (commit them but ignore local modifications during development)
# /frontend/src/api/generated/
# /frontend/src/types/api.ts

# Uncomment above lines if you want to ignore generated files
# For now, we'll commit them to ensure team synchronization
