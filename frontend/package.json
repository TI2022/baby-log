{
  "name": "baby-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run check-rules && next build",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "mock-server": "prism mock ../api/openapi.yaml --host 0.0.0.0 --port 3001",
    "mock-server:validate": "prism mock ../api/openapi.yaml --host 0.0.0.0 --port 3001 --validate-request --validate-response",
    "check-rules": "echo '🚨 開発ルール確認が必要です。以下を実行してください:' && echo 'cat ../docs/DEVELOPMENT_WORKFLOW.md | head -50' && echo 'cat ../docs/NEXTJS_CODING_RULES.md | head -100'",
    "rules": "cat ../docs/DEVELOPMENT_WORKFLOW.md && echo '\\n=== NEXTJS CODING RULES ===' && cat ../docs/NEXTJS_CODING_RULES.md | head -150"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "has-flag": "^5.0.1",
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "styled-components": "^6.1.0",
    "supports-color": "^10.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@stoplight/prism-cli": "^5.14.2",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/nextjs": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/test": "^8.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "storybook": "^8.4.0",
    "typescript": "^5"
  }
}
