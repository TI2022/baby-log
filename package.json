{
  "name": "baby-log-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "育児記録アプリケーション - モノレポ構成",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && rails server -p 3001",
    "dev:mock": "concurrently \"npm run mock-server\" \"npm run dev:frontend\"",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run start:frontend",
    "start:frontend": "cd frontend && npm start",
    "test": "concurrently \"npm run test:frontend\" \"npm run test:backend\"",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && rails test",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "mock-server": "cd frontend && npm run mock-server",
    "mock-server:validate": "cd frontend && npm run mock-server:validate",
    "storybook": "cd frontend && npm run storybook",
    "build-storybook": "cd frontend && npm run build-storybook",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && bundle install",
    "install:all": "concurrently \"npm run install:frontend\" \"npm run install:backend\"",
    "clean": "concurrently \"npm run clean:frontend\" \"npm run clean:backend\"",
    "clean:frontend": "cd frontend && rm -rf node_modules .next",
    "clean:backend": "cd backend && rm -rf tmp/cache/*"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
